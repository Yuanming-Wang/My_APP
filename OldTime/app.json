{
  "expo": {
    "name": "回忆",
    "slug": "OldTime",
    "owner": "metavis-bit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "需要访问相册以选择照片制作纪念册",
        "NSCameraUsageDescription": "需要访问相机以拍摄照片"
      }
    },
    "android": {
      "package": "com.oldtime.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "需要访问相册以选择照片制作纪念册",
          "cameraPermission": "需要访问相机以拍摄照片"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a1506756-e889-4f89-96d9-ea4ebaf1eb9d"
      }
    }
  }
}
